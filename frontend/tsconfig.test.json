{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./node_modules/.tmp/frontend-tests",
    "rootDir": "."
  },
  "include": [
    "src/even/audio.ts",
    "src/even/assistant-response-lifecycle.ts",
    "src/even/realtime-protocol.ts",
    "src/even/realtime-socket.ts",
    "src/shared/api/session-storage.ts",
    "tests/assistant-response-lifecycle.test.ts",
    "tests/audio.test.ts",
    "tests/index.test.ts",
    "tests/realtime-protocol.test.ts",
    "tests/realtime-socket.test.ts",
    "tests/session-storage.test.ts"
  ]
}
