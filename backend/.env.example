DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGIN=https://rev-eyes.com,https://www.rev-eyes.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BETA_ALLOWED_EMAILS=ferruben739@gmail.com
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_AGENT_MODEL=gpt-5.6-luna
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
JEV_API_KEY=YOUR_JEV_API_KEY
SCHEDULER_SECRET=YOUR_SCHEDULER_SECRET
SCHEDULE_REGISTRAR_URL=https://YOUR_SCHEDULE_REGISTRAR_URL
PORT=8080

CANDIDATE_AUDIO_ENABLED=false
CANDIDATE_AUDIO_MAX_CONCURRENCY=2
SERVER_MOONSHINE_ENABLED=true
SERVER_MOONSHINE_MAX_CONCURRENCY=1
MOONSHINE_MODEL_DIR=/opt/rev-eyes/moonshine/v0.1.5/model

# Optional T3 status integration; leave ALL blank to disable.
# A reachable, authenticated HTTPS /mcp endpoint is required. This is NOT
# laptop pairing. Never expose a raw localhost T3 listener to the internet.
# OWNER is the authenticated Supabase user UUID, NOT a model-selected value.
AGENT_T3_MCP_URL=
AGENT_T3_MCP_TOKEN=
AGENT_T3_OWNER_USER_ID=
# Enable explicit thread selection, conversation reading and queued messages.
# T3 OAuth must separately authorize the target thread's permission mode.
AGENT_T3_CONTROL_ENABLED=false
